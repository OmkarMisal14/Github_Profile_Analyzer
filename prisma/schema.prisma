generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GithubProfile {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  githubId          Int      @unique
  name              String?
  bio               String?  @db.Text
  company           String?
  location          String?
  blog              String?
  avatarUrl         String   @db.VarChar(500)
  profileUrl        String   @db.VarChar(500)
  publicRepos       Int
  publicGists       Int
  followers         Int
  following         Int
  totalStars        Int      @default(0)
  totalForks        Int      @default(0)
  accountAgeDays    Int
  followerRepoRatio Float?
  githubCreatedAt   DateTime
  analyzedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
